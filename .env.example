# Copy this file to .env and fill in real values. Never commit .env.

# Used by the postgres container to create the database on first start
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Postgres connection string used by the app.
# Inside Docker Compose the host is the service name "db", and "+psycopg" picks the driver, e.g.
# postgresql+psycopg://<user>:<password>@db:5432/<db>
DATABASE_URL=

# Database used only by the tests. It is dropped and recreated on every test run,
# so its name must end in _test, e.g.
# postgresql+psycopg://<user>:<password>@db:5432/lotwatcher_test
TEST_DATABASE_URL=

AUTODEV_API_KEY=
MARKETCHECK_API_KEY=
# Time zone for the 6 a.m. daily run, e.g. America/New_York
LOTWATCHER_TIMEZONE=
