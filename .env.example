# Copy this file to .env and fill in real values. Never commit .env.

# Used by the postgres container to create the database on first start
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Postgres connection string used by the app.
# Inside Docker Compose the host is the service name "db", e.g.
# postgresql://<user>:<password>@db:5432/<db>
DATABASE_URL=
